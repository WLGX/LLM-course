{
  "meta": {
    "说明": "唐诗宋词英译提示实验语料。共 16 篇（唐诗 8、宋词 8），开发集 4 篇（2 唐 2 词）用于校准提示与评分协议，正式测试集 12 篇在方案锁定后使用。文本依据通行版本（《全唐诗》《全宋词》及常见选本），均为公有领域古典作品；繁体来源统一转简体。每篇附关键语义单元，类别：time=时间/时序（对应作业要求的'期限'项）、neg=否定、except=例外/转折、term=术语/文化词、relation=关系（主客体/条件/因果/问答）。format=格式项对所有译文统一程序化检查（JSON 合法、行数一致、notes≤2、不超过 120 词、不含标题）。",
    "生成日期": "2026-10-31"
  },
  "poems": [
    {
      "id": "D1",
      "split": "dev",
      "genre": "唐诗",
      "title": "夜雨寄北",
      "author": "李商隐",
      "lines": ["君问归期未有期，", "巴山夜雨涨秋池。", "何当共剪西窗烛，", "却话巴山夜雨时。"],
      "units": [
        {"text": "未有期", "category": "neg", "note": "归期尚无着落，是否定；不得译成已有确定归期。"},
        {"text": "巴山", "category": "term", "note": "地名，应音译（Bashan）或保留意象，不宜意译成普通山名。"},
        {"text": "夜雨…时（当下之雨 vs 将来回叙之雨）", "category": "time", "note": "第二句是当下秋夜，第四句是未来重逢时回忆中的雨；时态层次须区分。"},
        {"text": "却话", "category": "except", "note": "转折：将来重逢时回叙今夜；'却'的回叙方向要保留。"}
      ]
    },
    {
      "id": "D2",
      "split": "dev",
      "genre": "唐诗",
      "title": "回乡偶书·其一",
      "author": "贺知章",
      "lines": ["少小离家老大回，", "乡音无改鬓毛衰。", "儿童相见不相识，", "笑问客从何处来。"],
      "units": [
        {"text": "少小…老大", "category": "time", "note": "离乡与回乡的时间跨度对比，须体现'年幼离开、年迈归来'。"},
        {"text": "无改", "category": "neg", "note": "乡音没有改变；否定结构，不能译成'乡音已变'。"},
        {"text": "不相识", "category": "neg", "note": "儿童认不出我；否定结构。"},
        {"text": "客从何处来", "category": "relation", "note": "儿童把我当作外来的客人；主客关系颠倒（主人被当作客），须保留问句方向。"}
      ]
    },
    {
      "id": "D3",
      "split": "dev",
      "genre": "宋词",
      "title": "浣溪沙·一曲新词酒一杯（片段）",
      "author": "晏殊",
      "lines": ["无可奈何花落去，", "似曾相识燕归来，", "小园香径独徘徊。"],
      "units": [
        {"text": "无可奈何", "category": "neg", "note": "无力挽留；否定/无奈义，不能译成主动任其凋落。"},
        {"text": "似曾相识", "category": "except", "note": "与前句转折：花落无奈，燕子归来却似曾相识。"},
        {"text": "独徘徊", "category": "relation", "note": "主体（词人）独自徘徊；动作发出者须是词人本人。"}
      ]
    },
    {
      "id": "D4",
      "split": "dev",
      "genre": "宋词",
      "title": "虞美人·春花秋月何时了（片段）",
      "author": "李煜",
      "lines": ["春花秋月何时了？", "往事知多少。", "小楼昨夜又东风，", "故国不堪回首月明中。"],
      "units": [
        {"text": "何时了", "category": "time", "note": "问时间何时终结；疑问结构，不是陈述。"},
        {"text": "昨夜", "category": "time", "note": "具体时间点：昨夜东风又起。"},
        {"text": "不堪", "category": "neg", "note": "不忍、不能承受；否定义。"},
        {"text": "故国", "category": "term", "note": "指已亡的故土国家，含亡国者视角；不得译成普通'家乡'。"}
      ]
    },
    {
      "id": "T1",
      "split": "test",
      "genre": "唐诗",
      "title": "九月九日忆山东兄弟",
      "author": "王维",
      "lines": ["独在异乡为异客，", "每逢佳节倍思亲。", "遥知兄弟登高处，", "遍插茱萸少一人。"],
      "units": [
        {"text": "异乡/异客", "category": "term", "note": "双重陌生：异地+外来的客人；'异'的重复义应体现。"},
        {"text": "佳节", "category": "term", "note": "指重阳节（题中九月九日）；可保留为 festival 并可用 notes 说明是重阳。"},
        {"text": "遥知", "category": "relation", "note": "我在远方推想兄弟的行为；视角从'我'转到'对方'，主客关系须保留。"},
        {"text": "茱萸…少一人", "category": "except", "note": "重阳插茱萸习俗 + 例外：独缺我一人；'少一人'是整首诗的落点。"}
      ]
    },
    {
      "id": "T2",
      "split": "test",
      "genre": "唐诗",
      "title": "登鹳雀楼",
      "author": "王之涣",
      "lines": ["白日依山尽，", "黄河入海流。", "欲穷千里目，", "更上一层楼。"],
      "units": [
        {"text": "依山尽 / 入海流", "category": "relation", "note": "白日贴着山落下、黄河奔向海；两组主宾方向关系（依山、入海）须准确。"},
        {"text": "欲穷…更上…", "category": "relation", "note": "条件递进：想看尽千里之外，就要再登一层；'欲…更…'的关联。"},
        {"text": "千里目", "category": "term", "note": "夸张意象'望尽千里的眼界'，不宜译成字面一千里的眼睛。"}
      ]
    },
    {
      "id": "T3",
      "split": "test",
      "genre": "唐诗",
      "title": "清明",
      "author": "杜牧",
      "lines": ["清明时节雨纷纷，", "路上行人欲断魂。", "借问酒家何处有？", "牧童遥指杏花村。"],
      "units": [
        {"text": "清明", "category": "term", "note": "节气/节日名；音译 Qingming 或保留意象并可用 notes 解释，不宜直接换成西方节日名。"},
        {"text": "借问…遥指", "category": "relation", "note": "问答结构：行人问、牧童指；问与答的动作发出者须区分。"},
        {"text": "杏花村", "category": "term", "note": "村名意象（杏花深处的村庄），不宜意译成普通 village 而丢失'杏花'。"}
      ]
    },
    {
      "id": "T4",
      "split": "test",
      "genre": "唐诗",
      "title": "出塞",
      "author": "王昌龄",
      "lines": ["秦时明月汉时关，", "万里长征人未还。", "但使龙城飞将在，", "不教胡马度阴山。"],
      "units": [
        {"text": "秦时…汉时", "category": "time", "note": "互文：秦汉以来的明月与关塞；时间的久远感。"},
        {"text": "人未还", "category": "neg", "note": "征人至今未归；否定结构。"},
        {"text": "但使…不教…", "category": "relation", "note": "条件假设：只要有飞将在，就不让胡马越过；条件与结果关系。"},
        {"text": "龙城飞将 / 阴山", "category": "term", "note": "飞将指李广（典故），阴山是地名；文化指称可用拼音+notes 解释。"}
      ]
    },
    {
      "id": "T5",
      "split": "test",
      "genre": "唐诗",
      "title": "秋词·其一",
      "author": "刘禹锡",
      "lines": ["自古逢秋悲寂寥，", "我言秋日胜春朝。", "晴空一鹤排云上，", "便引诗情到碧霄。"],
      "units": [
        {"text": "自古…我言…胜…", "category": "except", "note": "反传统的例外判断：古人悲秋，我却说秋日胜过春日；对比与反例须保留。"},
        {"text": "自古/春朝", "category": "time", "note": "从古至今的惯例与春天作时间对照。"},
        {"text": "鹤排云上→诗情到碧霄", "category": "relation", "note": "由鹤引发的因果：鹤飞云上，把诗情引上碧霄；主客体关系。"}
      ]
    },
    {
      "id": "T6",
      "split": "test",
      "genre": "唐诗",
      "title": "静夜思",
      "author": "李白",
      "lines": ["床前明月光，", "疑是地上霜。", "举头望明月，", "低头思故乡。"],
      "units": [
        {"text": "疑是…霜", "category": "relation", "note": "比喻/错觉：月光疑似地上霜；'疑'的揣测义不能译成确定判断。"},
        {"text": "举头…低头", "category": "relation", "note": "动作对偶：抬头望月、低头思乡；动作方向与顺序。"},
        {"text": "故乡", "category": "term", "note": "家乡；最后一句的落点，情感方向（思乡）须保留。"}
      ]
    },
    {
      "id": "T7",
      "split": "test",
      "genre": "宋词",
      "title": "雨霖铃（片段）",
      "author": "柳永",
      "lines": ["执手相看泪眼，", "竟无语凝噎。", "念去去、千里烟波，", "暮霭沉沉楚天阔。"],
      "units": [
        {"text": "竟无语凝噎", "category": "except", "note": "转折：执手含泪相对，却哽咽说不出话；'竟'的反预期义。"},
        {"text": "去去", "category": "time", "note": "未来的行程（这一去千里迢迢）；时间上指向离开之后。"},
        {"text": "楚天", "category": "term", "note": "南方天空的意象词（楚地），不宜译成普通天空而丢失地理色彩；可用 notes。"}
      ]
    },
    {
      "id": "T8",
      "split": "test",
      "genre": "宋词",
      "title": "声声慢（片段）",
      "author": "李清照",
      "lines": ["寻寻觅觅，冷冷清清，凄凄惨惨戚戚。", "雁过也，正伤心，", "却是旧时相识。"],
      "units": [
        {"text": "寻寻觅觅…戚戚", "category": "relation", "note": "七组叠词层层递进铺陈心境；形式上的叠用应尽量体现（如重复/头韵），不能摊平成一句叙述。"},
        {"text": "旧时相识", "category": "time", "note": "过去就认识的（雁）；'旧时'的时间义。"},
        {"text": "却是", "category": "except", "note": "转折：正伤心时，偏偏发现是旧时相识；'却'的反预期义。"}
      ]
    },
    {
      "id": "T9",
      "split": "test",
      "genre": "宋词",
      "title": "水调歌头（片段）",
      "author": "苏轼",
      "lines": ["人有悲欢离合，", "月有阴晴圆缺，", "此事古难全。", "但愿人长久，", "千里共婵娟。"],
      "units": [
        {"text": "古难全", "category": "neg", "note": "自古以来就难以两全；否定+时间的双重含义。"},
        {"text": "但愿", "category": "relation", "note": "愿望式条件：只希望人长久；'但'的让步/限定义。"},
        {"text": "婵娟", "category": "term", "note": "月亮的雅称；须译出'共赏明月'，不能丢'婵娟'所代指的对象。"}
      ]
    },
    {
      "id": "T10",
      "split": "test",
      "genre": "宋词",
      "title": "满江红（片段）",
      "author": "岳飞",
      "lines": ["三十功名尘与土，", "八千里路云和月。", "莫等闲、白了少年头，", "空悲切。"],
      "units": [
        {"text": "三十…八千里", "category": "time", "note": "数字对仗：三十年功名、八千里征程；时间与空间并置。"},
        {"text": "莫等闲", "category": "neg", "note": "劝诫否定：不要虚度（莫）；否定祈使。"},
        {"text": "空悲切", "category": "except", "note": "徒然悲伤；'空'的落空义与劝诫的因果（莫等闲→否则空悲切）。"}
      ]
    },
    {
      "id": "T11",
      "split": "test",
      "genre": "宋词",
      "title": "鹊桥仙（片段）",
      "author": "秦观",
      "lines": ["柔情似水，", "佳期如梦，", "忍顾鹊桥归路。", "两情若是久长时，", "又岂在朝朝暮暮。"],
      "units": [
        {"text": "似水 / 如梦", "category": "relation", "note": "比喻：柔情如水、佳期如梦；'似/如'的比喻义不能译成等同判断。"},
        {"text": "鹊桥", "category": "term", "note": "七夕牛郎织女典故的鹊桥；可用 magpie bridge + notes 解释。"},
        {"text": "岂在朝朝暮暮", "category": "except", "note": "反问否定：哪里在于朝夕相守；反问结构+时间词'朝朝暮暮'。"}
      ]
    },
    {
      "id": "T12",
      "split": "test",
      "genre": "宋词",
      "title": "丑奴儿·书博山道中壁（片段）",
      "author": "辛弃疾",
      "lines": ["少年不识愁滋味，", "爱上层楼。", "而今识尽愁滋味，", "欲说还休。", "却道天凉好个秋。"],
      "units": [
        {"text": "不识（少年）", "category": "neg", "note": "少年时不懂愁；否定+时间（少年）。"},
        {"text": "而今", "category": "time", "note": "与'少年'对照的现在；时间对比须保留。"},
        {"text": "却道天凉好个秋", "category": "except", "note": "转折：满腹愁绪却只说'天凉好个秋'；'却'与言不由衷的落差。"}
      ]
    }
  ]
}
